{
  "providers": [
    {
      "name": "my-openai",
      "type": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "MY_OPENAI_KEY"
    },
    {
      "name": "work-claude",
      "type": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "WORK_ANTHROPIC_KEY"
    },
    {
      "name": "local",
      "type": "ollama",
      "base_url": "http://localhost:11434/v1"
    },
    {
      "name": "google",
      "type": "gemini",
      "base_url": "https://generativelanguage.googleapis.com",
      "api_key_env": "GEMINI_API_KEY"
    }
  ],
  "aliases": {
    "fast": "my-openai:gpt-4o-mini",
    "smart": "my-openai:gpt-4o",
    "sonnet": "work-claude:claude-sonnet-4",
    "local": "local:llama3.1",
    "gem": "google:gemini-1.5-pro"
  },
  "keys": [
    {
      "name": "team-a",
      "api_key_env": "KEY_TEAM_A",
      "aliases": ["fast", "local"]
    },
    {
      "name": "team-b",
      "api_key_env": "KEY_TEAM_B",
      "aliases": ["sonnet", "fast"]
    }
  ]
}
