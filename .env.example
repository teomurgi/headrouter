# Server
HOST=0.0.0.0
PORT=8000

# Gateway auth: comma-separated API keys. Empty = auth disabled.
GATEWAY_API_KEYS=

# Model routing: alias=provider:model,alias2=provider2:model2
GATEWAY_ROUTES=sonnet=anthropic:claude-sonnet-4,gpt4o=openai:gpt-4o,gem=gemini:gemini-2.0-flash,local=ollama:llama3.1

# Fallback route for models not listed above
GATEWAY_DEFAULT_ROUTE=openai:gpt-4o-mini

# Providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Headroom compression
COMPRESSION_ENABLED=1
COMPRESSION_THRESHOLD_TOKENS=4000

# Upstream request timeout
REQUEST_TIMEOUT_SECONDS=300
