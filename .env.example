# Server
HOST=0.0.0.0
PORT=8000

# Gateway auth: comma-separated API keys. Empty = auth disabled.
GATEWAY_API_KEYS=

# Custom providers: point to a JSON file (see providers.example.json) or inline JSON.
# Entries define name, type (openai|openrouter|ollama|anthropic|gemini), base_url and api_key / api_key_env.
GATEWAY_PROVIDERS_FILE=providers.json
# GATEWAY_PROVIDERS={"providers":[{"name":"my-openai","type":"openai","base_url":"https://proxy.example.com/v1","api_key_env":"MY_OPENAI_KEY"}]}

# Model routing: alias=provider:model,alias2=provider2:model2
# Provider names may be custom (from the JSON above) or built-in (openai, anthropic, gemini, ollama, openrouter).
GATEWAY_ROUTES=sonnet=work-claude:claude-sonnet-4,gpt4o=my-openai:gpt-4o,gem=google:gemini-2.0-flash

# Fallback route for models not listed above
GATEWAY_DEFAULT_ROUTE=openai:gpt-4o-mini

# Providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Headroom compression
COMPRESSION_ENABLED=1
COMPRESSION_THRESHOLD_TOKENS=4000

# Upstream request timeout
REQUEST_TIMEOUT_SECONDS=300
